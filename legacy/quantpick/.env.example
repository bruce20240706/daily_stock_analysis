# ---------------------------------------------------------------------------
# LLM provider credentials for the AI-enhancement layer (Phase 3).
# Copy this file to ".env" and fill in your own keys.
#
# SECURITY: ".env" is git-ignored. NEVER commit real keys, and never paste a
# key into source code, comments, logs, or tests. Keys are read from the
# environment only (see quantpick/core/config.py).
# ---------------------------------------------------------------------------

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI-compatible endpoints (DeepSeek / Qwen / etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Default model id used by the LLM analyst (override as needed)
QUANTPICK_LLM_MODEL=claude-sonnet-4-6
